{
    "$schema": "../schema/config.schema.json",
    "geometry": {
        "source": "analytical",
        "analytical": {
            "spacecraft": {
                "type": "sphere",
                "center": [
                    0.0,
                    0.0,
                    0.0
                ],
                "radius": 0.075,
                "voltage_V": -5.0
            },
            "antennas": []
        }
    },
    "toggles": {
        "enable_spis_background_field": true,
        "enable_plasma_self_field": false,
        "enable_antenna_particle_collection": false,
        "enable_rc_circuit_response": false,
        "enable_antenna_bias_voltage": false,
        "particle_boundary_mode": "open",
        "particle_spacecraft_mode": "absorb"
    },
    "physics": {
        "ion_mass_amu": 56.0,
        "total_impact_charge_C": 7.8e-14,
        "plasma_injection_mode": "point_cloud",
        "impact": {
            "location": [
                0.3,
                0.0,
                0.0
            ],
            "direction": [
                -1.0,
                0.0,
                0.0
            ],
            "normal": [
                1.0,
                0.0,
                0.0
            ],
            "time_delay_s": 0.0,
            "electron_temperature_eV": 2.0,
            "ion_temperature_eV": 5.0
        }
    },
    "numeric": {
        "num_macroparticles": 200000,
        "time_step_s": 1e-08,
        "num_time_steps": 20000,
        "domain_half_length_m": [
            0.6,
            0.6,
            0.6
        ],
        "grid_nodes": [
            81,
            81,
            81
        ],
        "field_precision": "float64"
    },
    "plotting": {
        "run_physical_simulation": true,
        "show_interactive_gui_windows": false,
        "save_plots_to_disk": true,
        "show_currents": false,
        "show_fields_slice": false,
        "show_potential_line_x": false,
        "show_particles_3d": true,
        "show_velocity_anim": false,
        "export_csv_time_series": false,
        "output_format": "h5",
        "output_h5_filepath": "outputs/validation_escape_m5.h5",
        "output_npz_filepath": "outputs/validation_escape_m5.npz",
        "output_csv_filepath": "outputs/validation_escape_m5.csv",
        "file_particles_anim": "outputs/validation_escape_m5_castice.gif",
        "enable_checkpointing": false,
        "checkpoint_interval_steps": 500,
        "export_vtk": false,
        "vtk_output_dir": "outputs/paraview_vtk"
    }
}