# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary files - preserve exact bytes
*.vtk binary
*.vti binary
*.vtp binary
*.pvd text eol=lf
*.h5 binary
*.npz binary
*.png binary
*.gif binary
